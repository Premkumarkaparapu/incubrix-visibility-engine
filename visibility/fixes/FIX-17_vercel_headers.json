<!-- FIX-17: Add vercel.json configuration header rules ensuring all production assets deliver nosniff and strict cross-origin policies. -->
<!-- Target URL: https://incubrix.com/ -->
<!-- Validator: SecurityHeaders.com (Status: Yes) -->

{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
